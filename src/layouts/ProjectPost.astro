---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import RippleBoard from '../components/RippleBoard.astro';
import { Image } from 'astro:assets';

type Props = CollectionEntry<'projects'>['data'] & {
	/** Collection id; seeds this post's board so every project gets its own. */
	slug: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	status,
	tags,
	repo,
	difficulty,
	cost,
	slug,
} = Astro.props;

const statusLabel = {
	complete: 'Complete',
	'in-progress': 'In progress',
	shelved: 'Shelved',
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em 4em;
			}

			/* ---- breadcrumb ---- */
			.back {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: rgb(var(--text-muted));
				text-decoration: none;
				display: inline-block;
				margin-bottom: 1.5rem;
			}
			.back:hover { color: var(--accent-light); }
			.back .prompt { color: var(--copper-light); }

			/* ---- title block ---- */
			.title-block {
				margin-bottom: 1.5rem;
			}
			.title-block h1 {
				font-size: 2.3rem;
				line-height: 1.15;
				margin: 0 0 0.5rem;
			}
			.title-block .desc {
				font-size: 1.1rem;
				color: rgb(var(--text-muted));
				margin: 0;
			}

			/* ---- metadata bar: ruled spec-sheet strip, no card ---- */
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				padding: 1rem 0;
				border-top: 2px solid var(--copper);
				border-bottom: 1px solid var(--copper-rule);
				margin-bottom: 2rem;
				font-size: 0.9rem;
			}
			.meta-item {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
			}
			.meta-label {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--copper-light);
			}
			.meta-value {
				font-family: var(--font-mono);
				color: rgb(var(--text));
				font-weight: 600;
			}
			.meta-value a { color: var(--accent-light); }

			.status-dot {
				display: inline-block;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				margin-right: 0.4rem;
				vertical-align: middle;
			}
			.status-complete { background: var(--accent); }
			.status-in-progress { background: var(--copper); }
			.status-shelved { background: rgb(var(--text-muted)); }

			.stars-filled { color: var(--copper); }
			.stars-empty { color: rgb(var(--text-muted)); opacity: 0.5; }

			/* ---- tags ---- */
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 2rem;
			}
			.tag {
				font-size: 0.75rem;
				font-family: var(--font-mono);
				padding: 0.2rem 0.6rem;
				background: rgba(255, 255, 255, 0.08);
				color: var(--copper-light);
			}

			/* ---- hero: squared, no shadow ---- */
			.hero-img {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-img img {
				display: block;
				width: 100%;
				height: auto;
			}

			/* ---- article body ---- */
			.prose {
				color: rgb(var(--text-muted));
				line-height: 1.7;
			}
			.prose :global(h2) {
				margin-top: 2.5rem;
				padding-bottom: 0.3rem;
				border-bottom: 1px solid var(--copper-rule);
			}
			.prose :global(h3) { margin-top: 1.8rem; }
			.prose :global(pre) {
				padding: 1.2rem;
			}
			.prose :global(code):not(:global(pre code)) {
				background: rgba(255, 255, 255, 0.08);
				padding: 0.15em 0.4em;
				border-radius: 4px;
				font-size: 0.9em;
			}
			/* used for the short prefaces at the top of some write-ups, so it
			   reads as an aside rather than an oversized pull quote */
			.prose :global(blockquote) {
				border-left: 3px solid var(--copper);
				padding: 0.2rem 0 0.2rem 1rem;
				margin: 0 0 2rem;
				font-size: 0.95em;
			}
			.prose :global(blockquote p) {
				margin-bottom: 0.5em;
			}
			.prose :global(blockquote p:last-child) {
				margin-bottom: 0;
			}
			.prose :global(ul) { padding-left: 1.2rem; }
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
			}
			.prose :global(th),
			.prose :global(td) {
				border: 1px solid rgba(255, 255, 255, 0.15);
				padding: 0.5rem 0.7rem;
				text-align: left;
			}

			.updated {
				font-style: italic;
				font-size: 0.85rem;
				color: rgb(var(--text-muted));
			}

			@media (max-width: 720px) {
				.title-block h1 { font-size: 1.8rem; }
				.meta { gap: 1rem; }
			}
		</style>
	</head>

	<body>
		<RippleBoard mode="page" seed={slug} parts={tags.slice(0, 3)} />
		<Header />
		<main data-board-quiet>
			<a class="back" href="/projects"><span class="prompt">$</span> cd ../projects</a>

			<div class="title-block">
				<h1>{title}</h1>
				<p class="desc">{description}</p>
			</div>

			<div class="meta">
				<div class="meta-item">
					<span class="meta-label">Date</span>
					<span class="meta-value"><FormattedDate date={pubDate} /></span>
				</div>

				{status && (
					<div class="meta-item">
						<span class="meta-label">Status</span>
						<span class="meta-value">
							<span class={`status-dot status-${status}`}></span>
							{statusLabel[status]}
						</span>
					</div>
				)}

				{difficulty && (
					<div class="meta-item">
						<span class="meta-label">Difficulty</span>
						<span class="meta-value">
							<span class="stars-filled">{'★'.repeat(difficulty)}</span><span class="stars-empty">{'★'.repeat(5 - difficulty)}</span>
						</span>
					</div>
				)}

				{cost && (
					<div class="meta-item">
						<span class="meta-label">Cost</span>
						<span class="meta-value">{cost}</span>
					</div>
				)}

				{repo && (
					<div class="meta-item">
						<span class="meta-label">Source</span>
						<span class="meta-value"><a href={repo}>View code &rarr;</a></span>
					</div>
				)}
			</div>

			{tags && tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => <span class="tag" data-ping>{tag}</span>)}
				</div>
			)}

			{heroImage && (
				<div class="hero-img">
					<Image width={1020} height={510} src={heroImage} alt={title} />
				</div>
			)}

			{updatedDate && (
				<p class="updated">Updated <FormattedDate date={updatedDate} /></p>
			)}

			<div class="prose">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
