---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RippleBoard from '../components/RippleBoard.astro';
import { SITE_TITLE } from '../consts';

// A few on-brand "error" lines; one is picked at random each build.
const quips = [
	'This page browned out like my V0.2 buck converter under load.',
	'404: this route isn\'t on the mesh. No node picked it up.',
	'Couldn\'t find that one. Might\'ve been a cold solder joint.',
	'This link returned all 0xFF. Nothing on the bus.',
	'Page not found — probably still stuck in the Altoids tin with no GPS lock.',
];
const quip = quips[Math.floor(Math.random() * quips.length)];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`404 — ${SITE_TITLE}`} description="Page not found." />
		<style>
			.code {
				font-family: var(--font-minecraft), monospace;
				font-size: 5rem;
				line-height: 1;
				margin: 0 0 1.5rem;
				color: var(--copper-light);
				letter-spacing: 0.06em;
			}
			.terminal {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				line-height: 1.8;
				background: rgb(var(--bg-deep));
				border-left: 2px solid var(--copper);
				padding: 1rem 1.25rem;
				color: rgb(var(--text));
				overflow-wrap: anywhere;
			}
			.terminal p { margin: 0; }
			.prompt { color: var(--copper-light); }
			.err { color: #f1a39a; }
			.quip {
				color: rgb(var(--text-muted));
				margin: 0.6rem 0 !important;
				font-family: var(--font-atkinson), sans-serif;
				font-size: 1rem;
			}
			.terminal a { color: var(--accent-light); }
			.terminal a:hover { color: var(--accent); }
		</style>
	</head>
	<body>
		<RippleBoard mode="page" seed="404" />
		<Header />
		<main data-board-quiet>
			<p class="code">404</p>
			<div class="terminal">
				<p><span class="prompt">j4mes@archangel:~$</span> cd <span data-missing-path>that-page</span></p>
				<p class="err">bash: cd: <span data-missing-path>that-page</span>: No such file or directory</p>
				<p class="quip">{quip}</p>
				<p><span class="prompt">j4mes@archangel:~$</span> <a href="/">cd ~</a> <span class="prompt"># back to safety</span></p>
				<p><span class="prompt">j4mes@archangel:~$</span> <a href="/projects/">cd ../projects</a></p>
			</div>
		</main>
		<Footer />
		<script is:inline>
			// the same 404.html answers every missing URL, so the path comes from the address bar
			for (const el of document.querySelectorAll('[data-missing-path]')) el.textContent = decodeURI(location.pathname);
		</script>
	</body>
</html>
