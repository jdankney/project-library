---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectLog from '../components/ProjectLog.astro';
import FastFetch from '../components/FastFetch.astro';
import RippleBoard from '../components/RippleBoard.astro';
import MountedPortrait from '../components/MountedPortrait.astro';
import portrait from '../assets/me.jpg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

// Pull every project, newest first.
const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Surface whatever is actually on the bench right now, rather than hardcoding it.
const onTheBench = projects.find((p) => p.data.status === 'in-progress');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* no top padding: the hero sits flush under the header, so the fixed
			   page board never peeks through a gap above it */
			main {
				width: 860px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 0 1em 1em;
			}

			/* ---- full-bleed sections escape main's constrained width ---- */
			.bleed {
				width: 100vw;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
			}

			/* ---- Hero: the ripple board, with the text block and J1 on top.
			   The dot-grid class is the no-JS fallback; the canvas covers it. ---- */
			.hero {
				position: relative;
				overflow: hidden;
				background-color: rgb(var(--bg));
				cursor: crosshair;
			}
			.hero-inner {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 3rem;
				min-height: 680px;
				box-sizing: border-box;
				padding: 4rem 13% 4rem 8%;
			}
			.hero-text {
				max-width: 820px;
			}
			/* the pixel font's glyphs overflow upward past their line box, so the
			   eyebrow above needs extra clearance to avoid being overlapped */
			.hero-text .eyebrow {
				margin-bottom: 1.6rem;
			}
			.wordmark {
				font-family: var(--font-minecraft);
				font-size: clamp(2.25rem, 7vw, 4.25rem);
				/* 1.2, not tighter: when the wordmark wraps, the pixel glyphs of the
				   two lines would otherwise overlap */
				line-height: 1.2;
				letter-spacing: 0.02em;
				margin: 0 0 1.25rem;
				color: rgb(var(--text));
				text-shadow: 0 2px 18px rgba(0, 20, 30, 0.6);
			}

			/* copper trace running off a pad — the brand mark, borrowed from
			   the boards these projects are built on */
			.trace {
				display: flex;
				align-items: center;
				margin: 0 0 1.5rem;
			}
			.trace::before {
				content: '';
				width: 10px;
				height: 10px;
				background: var(--copper);
				flex-shrink: 0;
			}
			.trace::after {
				content: '';
				height: 2px;
				background: var(--copper);
				width: 300px;
				max-width: 55%;
			}

			.tagline {
				font-size: 1.15rem;
				font-weight: 600;
				color: rgb(var(--text-muted));
				margin: 0 0 1.5rem;
				max-width: 32em;
				text-shadow: 0 1px 12px rgba(0, 20, 30, 0.8);
			}

			/* on the bench right now — real state, not decoration */
			.bench {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: rgb(var(--text-muted));
				margin: 0;
			}
			.bench .marker {
				color: var(--copper-light);
			}
			.bench a {
				color: var(--accent-light);
				text-decoration: none;
				border-bottom: 1px solid var(--copper-rule);
			}
			.bench a:hover {
				border-bottom-color: var(--accent-light);
			}

			.hero-hint {
				position: absolute;
				right: 1.25rem;
				bottom: 0.9rem;
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.06em;
				color: rgb(var(--text-muted));
				pointer-events: none;
			}
			@media (hover: none) {
				.hint-mouse {
					display: none;
				}
			}
			@media (hover: hover) {
				.hint-touch {
					display: none;
				}
			}

			/* ---- Bio strip: paper, warm, personal; fastfetch lives here now ---- */
			.bio-strip {
				background: rgb(var(--paper));
				border-top: 3px solid var(--copper);
			}
			.bio-inner {
				max-width: 1060px;
				margin: 0 0 0 8%;
				padding: 3.5rem 1.5rem;
			}
			.bio-text {
				font-size: 1.1rem;
				line-height: 1.65;
				color: rgb(var(--ink-muted));
				margin: 0 0 1.75rem;
				max-width: 36em;
			}
			.bio-text strong {
				color: rgb(var(--bg));
			}

			/* stacked hero: text first, then J1 centred beneath it */
			@media (max-width: 900px) {
				.hero-inner {
					flex-direction: column;
					align-items: flex-start;
					min-height: 0;
					padding: 3rem 1.25rem 4rem;
				}
				.hero-inner > :global(.mount) {
					align-self: center;
				}
			}
			@media (max-width: 720px) {
				.bio-inner {
					margin-left: 0;
					padding-left: 1.25rem;
					padding-right: 1.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-board-quiet>
			<section class="hero bleed dot-grid">
				<RippleBoard mode="hero" seed="home" />
				<div class="hero-inner">
					<div class="hero-text" data-board-avoid>
						<p class="eyebrow">906.875 MHz · LongFast</p>
						<h1 class="wordmark">THE JDANKNEY VAULT</h1>
						<div class="trace"></div>
						<p class="tagline">
							The hardware and software I've built, broken down bit by bit.
						</p>
						{
							onTheBench && (
								<p class="bench">
									<span class="marker">▸</span> on the bench:{' '}
									<a href={`/projects/${onTheBench.id}/`}>{onTheBench.data.title}</a>
								</p>
							)
						}
					</div>
					<MountedPortrait src={portrait} alt="James Ankney" />
				</div>
				<p class="hero-hint" aria-hidden="true">
					<span class="hint-mouse">click</span><span class="hint-touch">tap</span> to transmit
				</p>
			</section>

			<section class="bio-strip bleed">
				<div class="bio-inner">
					<p class="eyebrow eyebrow--paper">Who's behind this</p>
					<p class="bio-text">
						I'm <strong>James Ankney/JDAnkney</strong>, a Computer Engineering student at Palomar College
						planning to transfer to UC San Diego. This is my project notebook: parts lists,
						wiring, firmware, and an honest record of the many things that caught fire along
						the way.
					</p>
					<FastFetch />
				</div>
			</section>

			<ProjectLog posts={projects} />
		</main>
		<RippleBoard mode="page" seed="home" />
		<Footer />
	</body>
</html>
