---
import HeaderLink from './HeaderLink.astro';
import GitHubIcon from './GitHubIcon.astro';
---

<header>
	<nav>
		<h2 class="brand"><a href="/">JDAV</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/jdankney" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">My GitHub profile</span>
				<GitHubIcon />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background-color: rgb(var(--bg));
		border-top: 3px solid var(--copper);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 20%);
	}

	/* 1fr / auto / 1fr keeps the links truly centred on the page no matter how
	   wide the wordmark or the icon are — space-between only centres the middle
	   item when both sides happen to be the same width. */
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	.brand {
		grid-column: 1;
		justify-self: start;
		margin: 0;
		font-family: var(--font-minecraft);
		font-size: 1.1em;
		letter-spacing: 0.03em;
		padding-top: 0.5em;
	}
	.brand a,
	.brand a.active {
		text-decoration: none;
	}

	.internal-links {
		grid-column: 2;
		justify-self: center;
		display: flex;
		align-items: center;
	}

	.social-links {
		grid-column: 3;
		justify-self: end;
		display: flex;
	}
	.social-links a {
		display: flex;
		color: var(--accent-light);
	}
	.social-links a:hover {
		color: var(--copper-light);
	}

	nav a {
		padding: 0.7em 0.5em;
		color: var(--accent-light);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		color: var(--copper-light);
		border-bottom-color: var(--copper);
	}

	/* Narrow screens: stack into two rows (brand + icon, then centred links)
	   rather than letting the links wrap raggedly against the wordmark.
	   The single row needs ~487px (99 brand + 241 links + 99 mirror + padding),
	   so 560px switches over with a little headroom to spare. */
	@media (max-width: 560px) {
		nav {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'brand social'
				'links links';
			row-gap: 0.15rem;
			padding-bottom: 0.4em;
		}
		.brand {
			grid-area: brand;
			padding-top: 0.6em;
		}
		.social-links {
			grid-area: social;
			padding-top: 0.6em;
		}
		.internal-links {
			grid-area: links;
			justify-self: center;
		}
		nav a {
			padding: 0.5em 0.6em;
		}
	}

	/* very small phones — tighten so all three links still fit on one line */
	@media (max-width: 360px) {
		nav a {
			padding: 0.5em 0.4em;
			font-size: 0.95em;
		}
	}
</style>
