---
import GitHubIcon from './GitHubIcon.astro';

const today = new Date();
---

<footer>
	<p class="copy">&copy; {today.getFullYear()} James Ankney</p>
	<div class="social-links">
		<a href="https://github.com/jdankney" target="_blank" rel="noopener noreferrer">
			<span class="sr-only">My GitHub profile</span>
			<GitHubIcon />
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3em 1em;
		background-color: rgb(var(--bg-deep));
		border-top: 2px solid var(--copper);
		color: rgb(var(--text-muted));
		text-align: center;
	}
	.copy {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		margin: 0;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--text-muted));
		transition: color 0.15s ease;
	}
	.social-links a:hover {
		color: var(--accent-light);
	}
</style>
